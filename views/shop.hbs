
<main>
  <h1>Shop</h1>

  {{#each products}}
    <article>
      <img src="{{image}}" alt="{{alt}}" width="300">
      <h2>{{name}}</h2>
      <p>Product ID: {{id}}</p>
      <p>Category: {{category}}</p>
{{!-- note euro is a helper function that formats the price as a euro currency string --}}
      <p>Price: {{euro price}}</p>
      <button type="button" data-add-to-cart="{{id}}">Add to cart</button>
    </article>
  {{/each}}
</main>